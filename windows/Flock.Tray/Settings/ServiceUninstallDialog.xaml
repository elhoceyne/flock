<ContentDialog
    x:Class="Flock.Tray.Settings.ServiceUninstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:settings="using:Flock.Tray.Settings"
    PrimaryButtonText="{l:Loc Key=Common_Uninstall}"
    CloseButtonText="{l:Loc Key=Common_Cancel}"
    DefaultButton="None"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}">
    <ContentDialog.Resources>
        <settings:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#C42B1C" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B22619" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#B22619" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A02216" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#A02216" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
    </ContentDialog.Resources>
    <StackPanel Spacing="16">
        <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" />
        <StackPanel Spacing="4" Visibility="{x:Bind HasData, Converter={StaticResource BooleanVisibilityConverter}}">
            <CheckBox Content="{x:Bind DeleteDataLabel}" IsChecked="{x:Bind DeleteData, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind DeletionWarning}" Margin="28,-4,0,0" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Visibility="{x:Bind DeleteData, Converter={StaticResource BooleanVisibilityConverter}}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
